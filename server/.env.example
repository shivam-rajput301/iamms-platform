# IAMMS Server — Environment Variables
# Copy this file to .env and fill in your values

# ─── MongoDB Atlas ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/iamms?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-string

# ─── Server ─────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
